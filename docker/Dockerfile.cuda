# syntax=docker/dockerfile:1
ARG CUDA_VERSION=12.8.1
ARG CUDA_DISTRO=ubuntu24.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-${CUDA_DISTRO} AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    CMAKE_ARGS=-DGGML_CUDA=on \
    FORCE_CMAKE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        ninja-build \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:${PATH}

WORKDIR /opt/emoparse
COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install ".[llamacpp,ui,lmstudio]"

# Verificación de build sin importar llama_cpp: libcuda.so.1 es una biblioteca del driver
# que NVIDIA inyecta en runtime, por lo que no tiene por qué existir durante docker build.
RUN python - <<'PY'
import importlib.metadata as metadata

dist = metadata.distribution("llama-cpp-python")
cuda_libs = sorted(
    str(path)
    for path in (dist.files or ())
    if "libggml-cuda.so" in str(path)
)
assert cuda_libs, "llama-cpp-python no contiene el backend CUDA compilado"
print("CUDA_BACKEND=OK", ",".join(cuda_libs))
PY

FROM nvidia/cuda:${CUDA_VERSION}-runtime-${CUDA_DISTRO}

ARG EMOPARSE_UID=1000
ARG EMOPARSE_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:${PATH} \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgomp1 \
        python3 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

RUN install -d \
        -o "${EMOPARSE_UID}" \
        -g "${EMOPARSE_GID}" \
        /home/emoparse /models /data /runs /config

ENV HOME=/home/emoparse

USER ${EMOPARSE_UID}:${EMOPARSE_GID}
WORKDIR /data

ENTRYPOINT ["emoparse"]
CMD ["--help"]
